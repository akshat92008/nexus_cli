+    finally:
+        record["output_truncated"] = bool(
+            _truncate_log(Path(record["stdout_log"]), int(record["max_output_bytes"]))
+            or _truncate_log(Path(record["stderr_log"]), int(record["max_output_bytes"]))
+        )
+        _cleanup_background_record(record)
