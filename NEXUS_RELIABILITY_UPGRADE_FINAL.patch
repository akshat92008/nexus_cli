-        elif source_suffix in (".py", ".pyi", ".pyx"):
-            module = imported.lstrip(".").replace(".", "/")
-            candidates.extend([root / f"{module}.py", root / module / "__init__.py"])
-        elif imported.startswith(("./", "../")):
-            base = source_path.parent / imported
