-        for raw in paths:
-            path = Path(raw).expanduser()
-            if not path.is_absolute():
-                path = self.root / path
-            path = path.resolve()
-            try:
-                relative = path.relative_to(self.root).as_posix()
-            except ValueError:
-                continue
-            stats.scanned += 1
-            if not path.exists():
-                if relative in self.files:
