-                [
-                    base,
-                    *(base.with_suffix(ext) for ext in (".ts", ".tsx", ".js", ".jsx")),
-                    *(base / f"index{ext}" for ext in (".ts", ".tsx", ".js", ".jsx")),
-                ]
-            )
-        for candidate in candidates:
-            try:
-                resolved = candidate.resolve()
-                resolved.relative_to(root)
-                if resolved.is_file():
