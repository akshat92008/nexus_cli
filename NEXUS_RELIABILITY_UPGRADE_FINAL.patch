-class InputSanitizer:
-    """Block protocol-embedded destructive commands and label prompt injection."""
-
-    _DANGEROUS = (
-        re.compile(
-            r"<<TEST_COMMAND>>\s*(?:sudo\s+)?(?:rm|del|format|mkfs|dd|shutdown|reboot)\b",
-            re.I,
-        ),
-        re.compile(r"\brm\s+-[^\n]*r[^\n]*f\s+(?:/|~|\$HOME)\b", re.I),
