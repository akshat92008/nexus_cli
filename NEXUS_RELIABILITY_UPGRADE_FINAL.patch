-            return parsed
-        synthetic = (
-            "<<THINKING>>\nRecovered hosted nested-fence response.\n\n<<FILES>>\n"
-            f"```{nested.group('language')}\n{nested.group('headers')}\n"
-            f"{nested.group('code').rstrip()}\n```"
