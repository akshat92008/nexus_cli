-        re.compile(r"ignore\s+(?:all\s+)?(?:previous|prior|above)\s+instructions?", re.I),
-        re.compile(r"system\s+(?:override|prompt|message)\s*:", re.I),
-        re.compile(r"you\s+are\s+now\b", re.I),
