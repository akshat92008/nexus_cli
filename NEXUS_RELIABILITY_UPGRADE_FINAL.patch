-    # ── Private Methods ──────────────────────────────────────────────────
-
-    def _absolute_path(self, filepath: str) -> str:
-        candidate = Path(filepath).expanduser()
-        if not candidate.is_absolute():
-            candidate = Path(self.working_dir) / candidate
-        return str(candidate.resolve())
