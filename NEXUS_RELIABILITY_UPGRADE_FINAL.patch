-    FILEPATH_PATTERN = re.compile(
-        r"(?:#|//|<!--|/\*|^|\s)filepath:\s*([^\s>*`'\"]+)",
-        re.IGNORECASE,
-    )
-    ACTION_PATTERN = re.compile(
-        r"(?:#|//|<!--|/\*|^|\s)action:\s*(CREATE|MODIFY|DELETE)",
-        re.IGNORECASE,
-    )
