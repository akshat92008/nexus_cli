-    )
-    RESPONSE_PATTERN = re.compile(
-        r"<<RESPONSE>>(.*?)(?=<<TEST_COMMAND>>|$)",
-        re.DOTALL | re.IGNORECASE,
-    )
-    CLARIFICATION_PATTERN = re.compile(
-        r"<<CLARIFICATION>>(.*?)(?=<<TEST_COMMAND>>|$)",
