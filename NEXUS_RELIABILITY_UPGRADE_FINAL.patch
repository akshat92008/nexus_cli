-        """Run the model + tool loop."""
-        t = time.monotonic()
-        agent = self._agent
-        try:
-            if routing_mode == "nova":
-                response, events = agent._run_nova_turn(user_input, emit_ui=emit_ui)  # noqa: SLF001
-            elif routing_mode == "two_node":
