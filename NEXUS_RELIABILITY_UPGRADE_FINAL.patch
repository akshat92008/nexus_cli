-                    break
-            if len(chosen) >= max_lines:
-                break
-        if len(chosen) < min(max_lines, 30):
-            for index in range(min(len(lines), max_lines - len(chosen))):
-                chosen.add(index)
-
-        rendered: list[str] = []
-        previous = -2
-        for index in sorted(chosen)[:max_lines]:
-            if index > previous + 1:
-                rendered.append("    ...")
-            rendered.append(f"{index + 1:5}: {lines[index]}")
