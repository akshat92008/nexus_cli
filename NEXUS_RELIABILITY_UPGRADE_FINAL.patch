-
-        with run_context_scope(self.run_context), tool_context(
-            self.working_dir, self.history, self.conversation_id
-        ):
-            result, success = self._execute_tool_with_safety_impl(
-                name,
-                args,
-                _user_initiated=_user_initiated,
